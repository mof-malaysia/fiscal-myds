{
  "name": "@mof-malaysia/ftds-style",
  "version": "1.0.0",
  "private": true,
  "description": "FTDS styles source for the shadcn registry. Not published to npm.",
  "scripts": {
    "dev": "tailwindcss --input ./styles/input.tailwind.css --output ./styles/output.tailwind.css --watch",
    "build": "tailwindcss --input ./styles/input.tailwind.css --output ./dist/index.css --minify"
  },
  "files": [
    "README.md",
    "dist",
    "styles"
  ],
  "exports": {
    "./full.css": {
      "default": "./dist/index.css"
    },
    "./color.css": {
      "default": "./styles/theme/color.css"
    },
    "./light.css": {
      "default": "./styles/theme/light.css"
    },
    "./dark.css": {
      "default": "./styles/theme/dark.css"
    },
    "./theme.css": {
      "default": "./styles/tailwind.config.css"
    }
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.17",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "postcss": "^8.5.6"
  },
  "peerDependencies": {
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0"
  }
}
