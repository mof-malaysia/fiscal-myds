{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/lib/ftds/utils": ["../react/src/utils/index.ts"],
      "@/lib/ftds/i18n": ["src/i18n/index.ts"],
      "@/components/ui/icons/*": ["src/icons/*"],
      "@/components/ui/*": [
        "src/components/core/*",
        "src/components/marketing/*"
      ],
      "@/components/blocks/*": ["src/components/marketing/*"]
    }
  }
}
