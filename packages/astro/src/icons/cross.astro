---
import type { HTMLAttributes } from "astro/types";

/** Cross icon. Props go to the <svg>, e.g. class="size-5". */
type Props = HTMLAttributes<"svg">;
---

<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" {...Astro.props}>
<g id="Icon/cross">
<path id="Vector" d="M14.8 5.20001L5.20001 14.8M5.20001 5.20001L14.8 14.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</g>
</svg>
