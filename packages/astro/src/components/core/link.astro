---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "class-variance-authority";
import { clx } from "@/lib/ftds/utils";
import { link_cva } from "@mof-malaysia/ftds-style/variants/link";

/**
 * An `<a>` in the FTDS theme.
 *
 * @example
 * <Link href="https://www.mof.gov.my" newTab primary>Ministry of Finance</Link>
 */
type Props = Omit<HTMLAttributes<"a">, "class"> &
  VariantProps<typeof link_cva> & {
    /** Opens in a new tab, with `rel="noopener noreferrer"`. */
    newTab?: boolean;
    class?: string;
  };

const {
  newTab = false,
  primary = false,
  underline = "always",
  class: className,
  ...props
} = Astro.props;
---

<a
  class={clx(link_cva({ primary, underline }), className)}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  {...props}><slot /></a
>
