---
/** Shell of the preview pages. Not shipped. */
import "../styles/preview.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="ms">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · FTDS Astro preview</title>
  </head>
  <body>
    <nav class="text-body-sm flex gap-4 px-4 py-2 md:px-6">
      <a href="/">Index</a><a href="/core">Core</a><a href="/marketing">Marketing</a>
    </nav>
    <main id="main"><slot /></main>
  </body>
</html>
