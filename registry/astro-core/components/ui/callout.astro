---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "class-variance-authority";
import { calloutVariants } from "@/components/ui/callout.variants";
import CheckCircle from "@/components/ui/icons/check-circle.astro";
import WarningCircle from "@/components/ui/icons/warning-circle.astro";
import Info from "@/components/ui/icons/info.astro";
import Warning from "@/components/ui/icons/warning.astro";

/**
 * Callout is a status message about one page or task, with an icon in the
 * variant's colour: `info` (default), `success`, `warning` or `danger`.
 * Danger is announced as an alert; the others politely, as a status.
 *
 * `title` is the bold line; the default slot is the text under it; the
 * `actions` slot holds buttons. A title alone is fine.
 *
 * @example
 * <Callout variant="warning" title="Your details don't match our records">
 *   The name you entered is different from the name on your MyKad.
 *   <Button slot="actions" variant="default-outline" href="/profile">Check my details</Button>
 * </Callout>
 */
type Props = Omit<HTMLAttributes<"div">, "class" | "title"> &
  VariantProps<typeof calloutVariants> & {
    title?: string;
    class?: string;
  };

const { variant = "info", title, class: className, ...props } = Astro.props;

const icons = {
  success: CheckCircle,
  warning: WarningCircle,
  info: Info,
  danger: Warning,
};
const Icon = icons[variant ?? "info"];
const slots = Astro.slots;
---

<div
  role={variant === "danger" ? "alert" : "status"}
  class={calloutVariants({ variant, className })}
  {...props}
>
  <Icon class="size-5 shrink-0" aria-hidden="true" />
  <div
    class="flex grow items-center justify-between gap-2 [&:has([role=definition])]:block [&:has([role=definition])]:space-y-1"
  >
    {
      (title || slots.has("title")) && (
        <p role="term" class="text-content font-semibold text-inherit">
          <slot name="title">{title}</slot>
        </p>
      )
    }
    {
      slots.has("default") && (
        <p role="definition" class="text-txt-black-900 peer text-content font-normal">
          <slot />
        </p>
      )
    }
    {
      slots.has("actions") && (
        <div class="flex gap-1 peer-[&[role=definition]]:pt-2">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</div>
