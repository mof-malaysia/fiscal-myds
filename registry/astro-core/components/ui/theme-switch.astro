---
import type { HTMLAttributes } from "astro/types";
import { clx } from "@/lib/ftds/utils";
import { label, resolveLang, type Lang } from "@/lib/ftds/i18n";
import Button from "@/components/ui/button.astro";
import Sun from "@/components/ui/icons/sun.astro";
import Moon from "@/components/ui/icons/moon.astro";

/**
 * ThemeSwitch is an icon button (sun or moon) that switches between the light
 * and dark themes. It sets `dark` (or `light`) on `<html>`, saves the choice
 * in localStorage under `storageKey`, and follows the system setting
 * (`prefers-color-scheme`) until a choice is saved. Put it in a top bar.
 *
 * It needs JavaScript, so it is hidden until the script runs. Add
 * `<ThemeScript />` to `<head>` too, with the same `storageKey`, so the saved
 * theme applies before the page paints.
 *
 * Its accessible name is `label` and the current theme: "Tema: Cerah".
 * Switching dispatches `ftds:theme-change` on `document` with
 * `detail.theme`.
 *
 * @example
 * <head><ThemeScript /></head>
 * ...
 * <ThemeSwitch />
 */
type Props = Omit<HTMLAttributes<"button">, "class"> & {
  /** Names the control, with the current theme after it. @default "Tema" / "Theme" */
  label?: string;
  /** @default "Cerah" / "Light" */
  lightLabel?: string;
  /** @default "Gelap" / "Dark" */
  darkLabel?: string;
  /** localStorage key the theme is saved under. @default "ftds-theme" */
  storageKey?: string;
  lang?: Lang;
  class?: string;
};

const {
  label: labelProp,
  lightLabel,
  darkLabel,
  storageKey = "ftds-theme",
  lang: langProp,
  class: className,
  ...props
} = Astro.props;

const lang = resolveLang(langProp, Astro.currentLocale);
const name = labelProp ?? label(lang, "theme");
const light = lightLabel ?? label(lang, "themeLight");
const dark = darkLabel ?? label(lang, "themeDark");
---

<Button
  variant="default-ghost"
  size="small"
  iconOnly
  hidden
  data-ftds-theme-switch
  data-storage-key={storageKey}
  data-label={name}
  data-light-label={light}
  data-dark-label={dark}
  aria-label={`${name}: ${light}`}
  class={clx("aspect-square shrink-0 rounded-md", className)}
  {...props}
>
  {/* The icon follows the <html> class, so it is right from the first paint */}
  <span class="contents dark:hidden"><Sun class="text-txt-black-900" aria-hidden="true" /></span>
  <span class="hidden dark:contents"><Moon class="text-txt-black-900" aria-hidden="true" /></span>
</Button>

<script>
  import { onEach } from "@/lib/ftds/scripts";

  type Theme = "light" | "dark";

  const root = document.documentElement;
  const media = matchMedia("(prefers-color-scheme: dark)");

  const stored = (key: string): Theme | null => {
    try {
      const value = localStorage.getItem(key);
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  };
  const current = (): Theme => (root.classList.contains("dark") ? "dark" : "light");

  /** Update every switch's name ("Theme: Dark") to the current theme. */
  const sync = () => {
    const theme = current();
    for (const button of document.querySelectorAll<HTMLElement>("[data-ftds-theme-switch]")) {
      const { label, lightLabel, darkLabel } = button.dataset;
      button.setAttribute("aria-label", `${label}: ${theme === "dark" ? darkLabel : lightLabel}`);
    }
  };

  const apply = (theme: Theme) => {
    root.classList.remove("light", "dark");
    root.classList.add(theme);
    sync();
    document.dispatchEvent(new CustomEvent("ftds:theme-change", { detail: { theme } }));
  };

  onEach("[data-ftds-theme-switch]", (button) => {
    const key = button.dataset.storageKey || "ftds-theme";
    // ThemeScript normally did this before paint; do it here in case it's missing
    if (!root.classList.contains("light") && !root.classList.contains("dark")) {
      apply(stored(key) ?? (media.matches ? "dark" : "light"));
    }

    button.hidden = false;
    sync();

    button.addEventListener("click", () => {
      const next: Theme = current() === "dark" ? "light" : "dark";
      try {
        localStorage.setItem(key, next);
      } catch {
        // Not saved: the switch still works for this page
      }
      apply(next);
    });

    // Follow the system until the visitor makes a choice
    media.addEventListener("change", (event) => {
      if (stored(key) === null) apply(event.matches ? "dark" : "light");
    });
  });
</script>
