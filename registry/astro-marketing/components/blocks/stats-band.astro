---
// registry:block — composed page section, installs to components/blocks
import type { HTMLAttributes } from "astro/types";
import { clx, uniqueId } from "@/lib/ftds/utils";
import SectionHeading from "@/components/ui/section-heading.astro";
import { grid_cva } from "@/components/ui/stats-band.variants";

/**
 * StatsBand shows two to four headline figures on a Well band. Each figure
 * is set large in tabular figures with a label and an optional footnote; the
 * markup is a description list, so screen readers hear the label first.
 * Slots: `title`, `description`, `source`.
 *
 * @example
 * <StatsBand
 *   title="The service in numbers"
 *   stats={[
 *     { value: "RM 4.2 bil", label: "Collected online in 2025" },
 *     { value: "1.8 juta", label: "Payments a month", footnote: "Average, Jan–Sep 2026" },
 *   ]}
 *   source="Source: Kementerian Kewangan, September 2026"
 * />
 */
interface Stat {
  value: string;
  label: string;
  footnote?: string;
}

type Props = Omit<HTMLAttributes<"section">, "class" | "title"> & {
  title?: string;
  description?: string;
  /** Two to four figures. Extra items are dropped. */
  stats: Stat[];
  /** Source or date line under the figures. */
  source?: string;
  /** `id` for the h2. Generated when unset. */
  titleId?: string;
  class?: string;
};

const {
  title,
  description,
  stats,
  source,
  titleId = uniqueId("stats-band"),
  class: className,
  ...props
} = Astro.props;

const slots = Astro.slots;
const hasTitle = Boolean(title) || slots.has("title");
const shown = stats.slice(0, 4);
const count = Math.max(1, shown.length) as 1 | 2 | 3 | 4;
---

<section
  aria-labelledby={hasTitle ? titleId : undefined}
  class={clx("bg-bg-washed font-body w-full", className)}
  {...props}
>
  <div class="mx-auto flex w-full max-w-[1280px] flex-col gap-10 px-4 py-12 md:px-6 md:py-16">
    <SectionHeading
      titleId={titleId}
      title={title}
      description={description}
      responsive={false}
      class="max-w-[720px]"
    >
      <slot name="title" slot="title" />
      <slot name="description" slot="description" />
    </SectionHeading>
    <dl class={grid_cva({ count })}>
      {
        shown.map((stat) => (
          <div class="flex flex-col gap-2">
            <dt class="text-txt-black-700 text-body-md order-2 font-medium">{stat.label}</dt>
            <dd class="text-txt-black-900 text-heading-md lg:text-heading-lg order-1 font-semibold tracking-[-0.02em] tabular-nums [font-feature-settings:'tnum'_1,'cv11'_1]">
              {stat.value}
            </dd>
            {stat.footnote && (
              <dd class="text-txt-black-700 text-body-sm order-3">{stat.footnote}</dd>
            )}
          </div>
        ))
      }
    </dl>
    {
      (source || slots.has("source")) && (
        <p class="text-txt-black-700 text-body-sm">
          <slot name="source">{source}</slot>
        </p>
      )
    }
  </div>
</section>
