---
import type { HTMLAttributes } from "astro/types";

/** ColumnCollapse icon. Props go to the <svg>, e.g. class="size-5". */
type Props = HTMLAttributes<"svg">;
---

<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" {...Astro.props}>
<g id="Icon/column-collapse">
<path id="Vector 146" d="M16 6L12 10L16 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
<path id="Vector 147" d="M4 14L8 10L4 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
<path id="Vector 160" d="M12 10L18 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
<path id="Vector 161" d="M2 10H8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</g>
</svg>
