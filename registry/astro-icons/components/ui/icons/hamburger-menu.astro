---
import type { HTMLAttributes } from "astro/types";

/** HamburgerMenu icon. Props go to the <svg>, e.g. class="size-5". */
type Props = HTMLAttributes<"svg">;
---

<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" {...Astro.props}>
<g id="Icon/hamburger-menu">
<path id="Vector" d="M2.75 4H17.25M2.75 16H17.25M2.75 10H17.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</g>
</svg>
