{
  "name": "ftds",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint --deny-warnings",
    "start": "turbo start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "lefthook install",
    "registry:generate": "tsx scripts/registry/build-multi.ts",
    "registry:generate:icons": "tsx scripts/registry/generate-icons.ts",
    "registry:generate:style": "tsx scripts/registry/generate-style.ts",
    "registry:build": "tsx scripts/registry/build-multi.ts",
    "registry:clean": "rm -rf registry registry.json",
    "registry:validate": "pnpm dlx shadcn@4.23.0 registry validate ./registry.json",
    "deploy:prepare": "tsx scripts/deploy/prepare-gh-pages.ts",
    "deploy:clean": "rm -rf deploy",
    "registry:generate:components": "tsx scripts/registry/generate-components.ts",
    "components:sync-exports": "tsx scripts/registry/sync-exports.ts",
    "typecheck": "turbo typecheck && tsc -p tsconfig.json",
    "lint:fix": "oxlint --fix",
    "icons:generate": "tsx scripts/icons/generate.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tsx": "^4.19.2",
    "turbo": "^2.6.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=18"
  }
}
