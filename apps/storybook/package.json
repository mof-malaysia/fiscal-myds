{
  "name": "@mof-malaysia/ftds-storybook",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o dist",
    "build:gh-pages": "BASE_PATH=/ftds/storybook storybook build -o dist",
    "deploy": "storybook build -o dist && wrangler deploy",
    "start": "serve storybook-static",
    "test-storybook": "test-storybook",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mof-malaysia/ftds-react": "workspace:*",
    "@mof-malaysia/ftds-style": "workspace:*",
    "@vitejs/plugin-react": "^4.3.2",
    "tailwindcss": "^4.1.17",
    "vite": "^5.4.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@playwright/test": "^1.50.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/addon-queryparams": "^10.1.0",
    "@storybook/react-vite": "^10.6.5",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "axe-playwright": "^2.1.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.47",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serve": "^14.2.4",
    "storybook": "^10.6.5",
    "storybook-addon-deep-controls": "^0.10.0",
    "tw-animate-css": "1.4.0",
    "wrangler": "4.155.0"
  }
}
