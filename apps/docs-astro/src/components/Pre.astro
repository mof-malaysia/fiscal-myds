---
/** Replaces `<pre>` in MDX so every code block gets a Well and a copy button. */
import CopyButton from "./CopyButton.astro";

const { class: className, ...rest } = Astro.props;
---

<div class="code-block group not-prose">
  <pre class={className} {...rest}><slot /></pre>
  <CopyButton class="absolute top-2 right-2" />
</div>
