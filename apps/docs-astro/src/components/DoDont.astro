---
/**
 * A do/don't pair. Put each sample in the `do` and `dont` slots; React
 * samples without a client directive render to plain HTML with no JavaScript.
 */
interface Props {
  title: string;
  doText: string;
  dontText: string;
}

const { title, doText, dontText } = Astro.props;
---

<div class="not-prose my-6">
  <p class="text-txt-black-900 mb-3 font-semibold">{title}</p>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      [
        { kind: "do", label: "Do", text: doText },
        { kind: "dont", label: "Don't", text: dontText },
      ].map((item) => (
        <figure>
          <div data-density="comfortable" class="bg-bg-white flex min-h-36 flex-wrap items-center justify-center gap-3 rounded-lg p-6">
            {item.kind === "do" ? <slot name="do" /> : <slot name="dont" />}
          </div>
          <figcaption class="mt-3 flex gap-2">
            <span
              class:list={[
                "inline-flex h-6 shrink-0 items-center gap-1 rounded-full px-2 text-[0.8125rem] font-medium",
                item.kind === "do" ? "bg-bg-success-50 text-txt-success" : "bg-bg-danger-50 text-txt-danger",
              ]}
            >
              {item.kind === "do" ? (
                <svg class="size-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="m4.5 10.5 3.5 3.5 7.5-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              ) : (
                <svg class="size-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="m5.5 5.5 9 9m0-9-9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              )}
              {item.label}
            </span>
            <span class="text-txt-black-700 text-sm leading-6">{item.text}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>
