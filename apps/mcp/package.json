{
  "name": "@mof-malaysia/ftds-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FTDS Playground: a remote MCP server whose tools let Claude or ChatGPT mock up screens with FTDS, previewed in the chat as an MCP App and shared as a link.",
  "scripts": {
    "catalogue": "tsx scripts/catalogue.cts",
    "build:view": "vite build",
    "build": "pnpm catalogue && pnpm build:view && wrangler deploy --dry-run --outdir dist/worker",
    "dev": "pnpm catalogue && pnpm build:view && wrangler dev",
    "deploy": "pnpm catalogue && pnpm build:view && wrangler deploy",
    "test": "tsx --test src/shared/check.test.ts",
    "typecheck": "pnpm catalogue && tsc --noEmit",
    "test:host": "vite --config test/host/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "lz-string": "1.5.0",
    "sucrase": "3.35.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mof-malaysia/ftds-react": "workspace:*",
    "@mof-malaysia/ftds-style": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "wrangler": "4.155.0"
  }
}
