    "@storybook-astro/framework": "^1.14.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/builder-vite": "^10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
